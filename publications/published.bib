@article{masters2026,
  abstract      = {Strained superlattice GaAs photocathodes are crucial for providing high photocurrent beams of spin-polarized electrons at several accelerator facilities including the Continuous Electron Beam Accelerator Facility at Thomas Jefferson National Accelerator Facility and the future Electron--Ion Collider at Brookhaven National Laboratory. In this work, we study the effects of varying the number of superlattice pairs on the polarization and photocurrent of the photocathodes. We observe a saturation in quantum efficiency beyond 30 pairs, with additional layers yielding minimal photocurrent improvement while noticeably reducing the polarization of the beam.},
  author        = {Masters, Adam and Blume, Greg and Poudel, Sushil and Grames, Joseph Michael and Poelker, Matt and Stutzman, Marcy and Polly, Stephen and Hubbard, Seth M. and Marsillac, Sylvain and Grau, Matt},
  date-added    = {2026-03-18 14:57:33 -0400},
  date-modified = {2026-03-18 14:57:33 -0400},
  doi           = {10.1063/5.0315264},
  eprint        = {https://pubs.aip.org/aip/apl/article-pdf/doi/10.1063/5.0315264/20916573/083501_1_5.0315264.pdf},
  issn          = {0003-6951},
  journal       = APL,
  month         = {02},
  number        = {8},
  pages         = {083501},
  title         = {Impact of superlattice size on quantum efficiency and polarization in MOCVD-grown strained GaAs/GaAsP photocathodes},
  url           = {https://doi.org/10.1063/5.0315264},
  volume        = {128},
  year          = {2026},
  bdsk-url-1    = {https://doi.org/10.1063/5.0315264}
}

