# Build output
_build/

# Generated output (rebuilt during render)
generated/

# Generated data/stats (rebuilt by update_metrics.py)
data/stats.*
data/macros.tex
# NOTE: data/gs_cache.json is deliberately TRACKED. CI builds run with
# CV_SCHOLAR_DISABLE=1, so the committed cache is the only source of citation
# counts there — without it, published CVs show "N/A citations" and the
# impact/weighted publication selections silently fall back to date order.

# LaTeX artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Python
.venv/
__pycache__/
*.pyc

# Quarto
/.quarto/
**/*.quarto_ipynb

# OS
.DS_Store

# Editor
.vscode/

/.luarc.json
